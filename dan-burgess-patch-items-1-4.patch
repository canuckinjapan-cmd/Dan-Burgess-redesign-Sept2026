@@ -0,0 +1,172 @@
+// Pure helpers for the contact endpoint (no Cloudflare imports, so they can be tested in Node).
+
+export const LIMITS = { name: 100, email: 254, company: 150, message: 5000 };
+const EMAIL_RE = /^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/;
+// eslint-disable-next-line no-control-regex
+const CONTROL_RE = /[\u0000-\u001f\u007f]+/g;
+
+/** Browsers always send Origin on a cross-origin-capable POST; require it to match this host. */
+export function isSameOrigin(request) {
+  const origin = request.headers.get("Origin");
+  if (!origin) return false;
+  try {
+    return new URL(origin).host === new URL(request.url).host;
+  } catch {
+    return false;
+  }
+}
+
+const oneLine = (v) => String(v ?? "").replace(CONTROL_RE, " ").trim();
+
+/**
+ * Validates and normalises the payload. Header-bound fields (name, email, company)
+ * are collapsed to one line, which is what prevents header injection.
+ * `hp_field` is a honeypot: humans never see it, bots fill it.
+ */
+export function validateContact(data) {
+  if (!data || typeof data !== "object" || Array.isArray(data)) return { ok: false, field: "body" };
+  if (typeof data.hp_field === "string" && data.hp_field.trim() !== "") return { ok: true, spam: true };
+
+  for (const k of ["name", "email", "company", "message"]) {
+    if (data[k] != null && typeof data[k] !== "string") return { ok: false, field: k };
+  }
+
+  const name = oneLine(data.name);
+  const email = oneLine(data.email);
+  const company = oneLine(data.company);
+  const message = String(data.message ?? "").replace(/\r\n?/g, "\n").replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g, "").trim();
+
+  if (!name || name.length > LIMITS.name) return { ok: false, field: "name" };
+  if (!email || email.length > LIMITS.email || !EMAIL_RE.test(email)) return { ok: false, field: "email" };
+  if (company.length > LIMITS.company) return { ok: false, field: "company" };
+  if (!message || message.length > LIMITS.message) return { ok: false, field: "message" };
+
+  return { ok: true, value: { name, email, company, message } };
+}
+
+const enc = new TextEncoder();
+
+export function toBase64(str) {
+  const bytes = enc.encode(str);
+  let bin = "";
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    bin += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
+  }
+  return btoa(bin);
+}
+
+const wrap76 = (s) => s.match(/.{1,76}/g)?.join("\r\n") ?? "";
+
+/** RFC 2047 encoded-words, split so each stays under the 75-character limit. */
+export function encodeSubject(text) {
+  const words = [];
+  let cur = "";
+  let curBytes = 0;
+  for (const ch of text) {
+    const n = enc.encode(ch).length;
+    if (curBytes + n > 42) {
+      words.push(cur);
+      cur = "";
+      curBytes = 0;
+    }
+    cur += ch;
+    curBytes += n;
+  }
+  if (cur) words.push(cur);
+  return words.map((w) => `=?UTF-8?B?${toBase64(w)}?=`).join("\r\n ");
+}
+
+/**
+ * Builds the full RFC 5322 message. The body is base64, so a message line that is just "."
+ * can never terminate the SMTP DATA phase early, and Japanese text survives any relay.
+ * The returned string has no trailing CRLF and no terminating dot.
+ */
+export function buildMessage({ from, to, name, email, company, message, date = new Date() }) {
+  const body = [
+    `Name: ${name}`,
+    `Email: ${email}`,
+    ...(company ? [`Company: ${company}`] : []),
+    "",
+    "Message:",
+    message,
+  ]
+    .join("\n")
+    .replace(/\n/g, "\r\n");
+
+  return [
+    `Date: ${date.toUTCString()}`,
+    `From: ${from}`,
+    `To: ${to}`,
+    `Reply-To: ${email}`,
+    `Subject: ${encodeSubject(`New inquiry from ${name.slice(0, 40)}`)}`,
+    "MIME-Version: 1.0",
+    "Content-Type: text/plain; charset=utf-8",
+    "Content-Transfer-Encoding: base64",
+    "",
+    wrap76(toBase64(body)),
+  ].join("\r\n");
+}
+
+/** Sends one message over implicit-TLS SMTP (port 465). `connect` is cloudflare:sockets' connect. */
+export async function sendMail({ connect, host, port = 465, user, pass, to, rawMessage, timeoutMs = 15000 }) {
+  const socket = connect({ hostname: host, port }, { secureTransport: "on" });
+  const writer = socket.writable.getWriter();
+  const reader = socket.readable.getReader();
+  const decoder = new TextDecoder();
+  let buffer = "";
+
+  const readReply = async (expected) => {
+    for (;;) {
+      const lines = buffer.split("\r\n");
+      for (let i = 0; i < lines.length - 1; i++) {
+        const m = /^(\d{3})([ -])/.exec(lines[i]);
+        if (!m) continue;
+        if (m[2] === " ") {
+          if (m[1] === expected) {
+            buffer = lines.slice(i + 1).join("\r\n");
+            return;
+          }
+          if (m[1][0] === "4" || m[1][0] === "5") throw new Error(`SMTP ${m[1]} (expected ${expected})`);
+        }
+      }
+      const { value, done } = await reader.read();
+      if (done) throw new Error("SMTP connection closed early");
+      buffer += decoder.decode(value, { stream: true });
+    }
+  };
+  const send = (line) => writer.write(enc.encode(line + "\r\n"));
+  const cmd = async (line, expected) => {
+    await send(line);
+    await readReply(expected);
+  };
+
+  const run = async () => {
+    await readReply("220");
+    await cmd("EHLO danburgess.com", "250");
+    await cmd("AUTH LOGIN", "334");
+    await cmd(btoa(user), "334");
+    await cmd(btoa(pass), "235");
+    await cmd(`MAIL FROM:<${user}>`, "250");
+    await cmd(`RCPT TO:<${to}>`, "250");
+    await cmd("DATA", "354");
+    await cmd(`${rawMessage}\r\n.`, "250");
+    await send("QUIT").catch(() => {});
+  };
+
+  let timer;
+  try {
+    await Promise.race([
+      run(),
+      new Promise((_, rej) => {
+        timer = setTimeout(() => rej(new Error("SMTP timeout")), timeoutMs);
+      }),
+    ]);
+  } finally {
+    clearTimeout(timer);
+    try {
+      await socket.close();
+    } catch {
+      /* already closed */
+    }
+  }
+}
diff --git a/functions/_lib/contact.test.mjs b/functions/_lib/contact.test.mjs
new file mode 100644
index 0000000..8f68e8a
--- /dev/null
+++ b/functions/_lib/contact.test.mjs
@@ -0,0 +1,91 @@
+// Run with: node --test functions/_lib/contact.test.mjs
+import test from "node:test";
+import assert from "node:assert/strict";
+import { validateContact, buildMessage, encodeSubject, isSameOrigin, sendMail } from "./contact.js";
+
+const good = { name: "Taro", email: "taro@example.co.jp", company: "", message: "Hello" };
+
+test("validate: accepts a normal payload", () => {
+  const r = validateContact(good);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.name, "Taro");
+});
+
+test("validate: header injection via email/name is rejected or flattened", () => {
+  assert.equal(validateContact({ ...good, email: "a@b.co\r\nBcc: x@y.z" }).ok, false);
+  const r = validateContact({ ...good, name: "Taro\r\nBcc: x@y.z" });
+  assert.equal(r.ok, true);
+  assert.ok(!/[\r\n]/.test(r.value.name));
+});
+
+test("validate: limits, types and honeypot", () => {
+  assert.equal(validateContact({ ...good, message: "x".repeat(5001) }).ok, false);
+  assert.equal(validateContact({ ...good, name: 5 }).ok, false);
+  assert.equal(validateContact(null).ok, false);
+  assert.equal(validateContact({ ...good, hp_field: "buy now" }).spam, true);
+});
+
+test("encodeSubject: every encoded-word <= 75 chars, Japanese intact", () => {
+  const s = encodeSubject("New inquiry from 山田太郎山田太郎山田太郎山田太郎");
+  for (const w of s.split("\r\n ")) assert.ok(w.length <= 75, w);
+});
+
+test("isSameOrigin", () => {
+  const mk = (origin) => ({ url: "https://www.danburgess.com/api/contact", headers: new Headers(origin ? { Origin: origin } : {}) });
+  assert.equal(isSameOrigin(mk("https://www.danburgess.com")), true);
+  assert.equal(isSameOrigin(mk("https://evil.example")), false);
+  assert.equal(isSameOrigin(mk(null)), false);
+});
+
+// --- fake SMTP server speaking through web streams
+function fakeConnect(log, { failAuth = false } = {}) {
+  return () => {
+    let ctl;
+    let inData = false;
+    let dataBuf = "";
+    const readable = new ReadableStream({ start(c) { ctl = c; c.enqueue(new TextEncoder().encode("220 fake ESMTP\r\n")); } });
+    const reply = (s) => ctl.enqueue(new TextEncoder().encode(s + "\r\n"));
+    let awaiting = null;
+    const writable = new WritableStream({
+      write(chunk) {
+        const text = new TextDecoder().decode(chunk);
+        if (inData) {
+          dataBuf += text;
+          if (dataBuf.endsWith("\r\n.\r\n")) { inData = false; log.data = dataBuf; reply("250 2.0.0 OK queued"); }
+          return;
+        }
+        for (const line of text.split("\r\n").filter(Boolean)) {
+          log.cmds.push(line.startsWith("EHLO") || /^(AUTH|MAIL|RCPT|DATA|QUIT)/.test(line) ? line : "<b64>");
+          if (awaiting === "user") { awaiting = "pass"; reply("334 UGFzc3dvcmQ6"); continue; }
+          if (awaiting === "pass") { awaiting = null; reply(failAuth ? "535 5.7.8 bad creds" : "235 2.7.0 Accepted"); continue; }
+          if (line.startsWith("EHLO")) { reply("250-fake"); reply("250-8BITMIME"); reply("250 AUTH LOGIN"); }
+          else if (line === "AUTH LOGIN") { awaiting = "user"; reply("334 VXNlcm5hbWU6"); }
+          else if (line.startsWith("MAIL") || line.startsWith("RCPT")) reply("250 OK");
+          else if (line === "DATA") { inData = true; reply("354 go ahead"); }
+        }
+      },
+    });
+    return { readable, writable, close: async () => { log.closed = true; } };
+  };
+}
+
+test("sendMail: full dialog, body is base64, dot-only line cannot end DATA early", async () => {
+  const log = { cmds: [] };
+  const v = validateContact({ ...good, message: "line one\r\n.\r\nQUIT\r\nMAIL FROM:<evil@x.y>\r\n日本語です" }).value;
+  const raw = buildMessage({ from: "me@example.com", to: "me@example.com", ...v });
+  await sendMail({ connect: fakeConnect(log), host: "x", user: "me@example.com", pass: "pw", to: "me@example.com", rawMessage: raw });
+  assert.deepEqual(log.cmds.filter((c) => /^(AUTH|MAIL|RCPT|DATA)/.test(c)), ["AUTH LOGIN", "MAIL FROM:<me@example.com>", "RCPT TO:<me@example.com>", "DATA"]);
+  assert.ok(log.closed);
+  const body = log.data.split("\r\n\r\n")[1];
+  assert.match(body, /^[A-Za-z0-9+/=\r\n.]+$/);
+  assert.equal((log.data.match(/\r\n\.\r\n/g) || []).length, 1);
+  const decoded = Buffer.from(body.replace(/\r\n\.\r\n$/, "").replace(/\r\n/g, ""), "base64").toString("utf8");
+  assert.ok(decoded.includes("日本語です") && decoded.includes("\r\n.\r\nQUIT"));
+  assert.match(log.data, /Reply-To: taro@example\.co\.jp\r\n/);
+});
+
+test("sendMail: auth failure rejects and still closes the socket", async () => {
+  const log = { cmds: [] };
+  await assert.rejects(sendMail({ connect: fakeConnect(log, { failAuth: true }), host: "x", user: "u@x.y", pass: "bad", to: "u@x.y", rawMessage: "x" }), /535/);
+  assert.ok(log.closed);
+});
