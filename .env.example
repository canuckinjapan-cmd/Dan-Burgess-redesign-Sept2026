# Cloudflare Pages Functions (functions/api/contact.js) read these from the
# Cloudflare dashboard (Settings > Variables and Secrets), not from this file.
# For local testing with `wrangler pages dev`, put them in a git-ignored .dev.vars file.

# SMTP account used to send contact-form mail (Gmail needs an app password)
SMTP_USER=you@example.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com

# Where inquiries are delivered (defaults to SMTP_USER)
CONTACT_EMAIL=you@example.com
