# Cloudflare Pages Functions (functions/api/contact.js) read these from the
# Cloudflare dashboard (Settings > Variables and Secrets), not from this file.
# For local testing with `wrangler pages dev`, put them in a git-ignored .dev.vars file.

# SMTP account used to send contact-form mail (Gmail needs an app password)
SMTP_USER=you@example.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com

# Where inquiries are delivered (defaults to SMTP_USER)
CONTACT_EMAIL=you@example.com

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Server-side secret read by functions/api/contact.js (set in Cloudflare Pages Variables and Secrets)
# Client-side site key embedded at Vite build time (set in Cloudflare Pages Build Environment Variables)
# Below are Cloudflare's published always-pass dummy test keys for local development & testing only:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

